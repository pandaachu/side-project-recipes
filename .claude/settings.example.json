{
  "$schema": "https://code.claude.com/settings-schema.json",
  "permissions": {
    "allow": [
      "Read",
      "Grep",
      "Glob",
      "Bash(npm run:*)",
      "Bash(npm install:*)",
      "Bash(npx:*)",
      "Bash(npx prisma:*)",
      "Bash(git:*)",
      "Bash(docker:*)",
      "Write",
      "Edit",
      "MultiEdit"
    ],
    "deny": [
      "Bash(rm -rf:*)",
      "Bash(sudo:*)",
      "Read(.env*)",
      "Edit(.env*)",
      "Write(.env*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "node $PWD/scripts/hooks/prevent-env-read.js"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node $PWD/scripts/hooks/post-edit.js"
          },
          {
            "type": "command",
            "command": "node $PWD/scripts/hooks/prevent-duplicate-query.js"
          }
        ]
      }
    ]
  }
}
